[
  {
    "id": "pbc_soletra_gestures",
    "name": "gestures",
    "type": "base",
    "system": false,
    "listRule": "owner = @request.auth.id || public = true",
    "viewRule": "owner = @request.auth.id || public = true",
    "createRule": "@request.auth.id != \"\" && owner = @request.auth.id",
    "updateRule": "owner = @request.auth.id && (@request.body.owner:isset = false || @request.body.owner = @request.auth.id)",
    "deleteRule": "owner = @request.auth.id",
    "fields": [
      {
        "id": "relation_owner",
        "name": "owner",
        "type": "relation",
        "required": true,
        "collectionId": "_pb_users_auth_",
        "cascadeDelete": true,
        "minSelect": 0,
        "maxSelect": 1
      },
      {
        "id": "text_label",
        "name": "label",
        "type": "text",
        "required": true,
        "min": 1,
        "max": 40
      },
      {
        "id": "select_kind",
        "name": "kind",
        "type": "select",
        "required": true,
        "maxSelect": 1,
        "values": [
          "letra",
          "palavra",
          "comando"
        ]
      },
      {
        "id": "select_alphabet",
        "name": "alphabet",
        "type": "select",
        "required": true,
        "maxSelect": 1,
        "values": [
          "libras",
          "asl"
        ]
      },
      {
        "id": "json_samples",
        "name": "samples",
        "type": "json",
        "required": true,
        "maxSize": 2000000
      },
      {
        "id": "bool_public",
        "name": "public",
        "type": "bool"
      },
      {
        "id": "text_author_name",
        "name": "author_name",
        "type": "text",
        "max": 60
      },
      {
        "id": "text_source",
        "name": "source",
        "type": "text",
        "max": 30
      },
      {
        "id": "autodate_created",
        "name": "created",
        "type": "autodate",
        "onCreate": true,
        "onUpdate": false
      },
      {
        "id": "autodate_updated",
        "name": "updated",
        "type": "autodate",
        "onCreate": true,
        "onUpdate": true
      }
    ],
    "indexes": [
      "CREATE INDEX `idx_gestures_owner` ON `gestures` (`owner`)",
      "CREATE INDEX `idx_gestures_public` ON `gestures` (`public`, `alphabet`)"
    ]
  }
]
